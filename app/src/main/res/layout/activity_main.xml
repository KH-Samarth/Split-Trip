<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="‹"
                android:textSize="30sp"
                android:textColor="#3159A5"
                android:backgroundTint="#EAF0FC"
                android:padding="0dp" />

            <TextView
                android:id="@+id/tripTitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="Trip Name"
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="#172554"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- Spending Overview -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#3159A5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL TRIP EXPENSES"
                    android:textColor="#DCE7FF"
                    android:textSize="12sp"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/totalSpentText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total Trip Cost: ₹0"
                    android:textColor="#FFFFFF"
                    android:textSize="29sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Add Expense -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add an expense"
            android:textColor="#172554"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E8ECF3"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <EditText
                    android:id="@+id/payerInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Who paid?"
                    android:singleLine="true"
                    android:inputType="textCapWords"
                    android:padding="14dp" />

                <EditText
                    android:id="@+id/amountInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Amount (₹)"
                    android:singleLine="true"
                    android:inputType="numberDecimal"
                    android:layout_marginTop="10dp"
                    android:padding="14dp" />

                <EditText
                    android:id="@+id/descInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="What was it for?"
                    android:singleLine="true"
                    android:inputType="textCapSentences"
                    android:layout_marginTop="10dp"
                    android:padding="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addExpenseButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add Expense"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:layout_marginTop="16dp"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Expense History -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Expense history"
            android:textColor="#172554"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E8ECF3"
            app:cardBackgroundColor="#FFFFFF">

            <TextView
                android:id="@+id/expenseLogText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No expenses recorded yet."
                android:textColor="#526078"
                android:textSize="14sp"
                android:padding="18dp"
                android:lineSpacingExtra="6dp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Delete Trip -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteTripButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete Trip"
            android:textAllCaps="false"
            android:textColor="#C62828"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"
            app:backgroundTint="#FCEAEA"
            app:cornerRadius="12dp" />

    </LinearLayout>

</ScrollView>
