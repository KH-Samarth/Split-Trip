<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:clipToPadding="false">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="‹"
                android:textSize="30sp"
                android:textColor="#3159A5"
                android:backgroundTint="#EAF0FC"
                android:padding="0dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tripTitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Trip Name"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="#172554"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tripDatesHeaderText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="🗓 24 Nov 2026 – 30 Nov 2026"
                    android:textColor="#64748B"
                    android:textSize="12sp" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/editTripButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:text="Edit"
                android:textAllCaps="false"
                android:textColor="#3159A5"
                android:textSize="13sp"
                app:backgroundTint="#EAF0FC"
                app:cornerRadius="10dp"
                app:elevation="0dp" />

        </LinearLayout>


        <!-- TRIP SECTION SELECTOR -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#EEE9FF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="5dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/itineraryTabButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="✦  Itinerary"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#7965C8"
                    app:elevation="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/expensesTabButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="₹  Expenses"
                    android:textAllCaps="false"
                    android:textColor="#7965C8"
                    android:textSize="14sp"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#EEE9FF"
                    app:elevation="0dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


    <!-- ITINERARY SECTION -->
    <LinearLayout
        android:id="@+id/itinerarySection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- PLACES TO VISIT SECTION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Places to visit ✦"
            android:textColor="#332B50"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginBottom="7dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Plan your upcoming stops and itinerary."
            android:textColor="#89819D"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addPlannedPlaceButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+  Add a place to visit"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="18dp"
            app:backgroundTint="#3159A5"
            app:cornerRadius="14dp"
            app:elevation="0dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/plannedPlaceEmptyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#DCE7FF"
            app:cardBackgroundColor="#EAF0FC">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍"
                    android:textSize="42sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No places to visit yet!"
                    android:textColor="#172554"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="14dp" />

                <TextView
                    android:id="@+id/plannedPlaceEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add your upcoming destinations to plan out your trip step by step."
                    android:textColor="#526078"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="9dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/plannedPlaceListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- DIVIDER BETWEEN SECTIONS -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E9DFD2"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="28dp" />

        <!-- PLACES YOU'VE VISITED SECTION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Places you've visited ✦"
            android:textColor="#332B50"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginBottom="7dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keep a little record of every place your trip takes you."
            android:textColor="#89819D"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addActivityButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+  Add a visited place"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="18dp"
            app:backgroundTint="#7965C8"
            app:cornerRadius="14dp"
            app:elevation="0dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/itineraryEmptyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#DDECE4"
            app:cardBackgroundColor="#EAF5EF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗺️"
                    android:textSize="42sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your memories start here!"
                    android:textColor="#365C49"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="14dp" />

                <TextView
                    android:id="@+id/itineraryEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No visited places recorded yet. Add your first stop and save a little memory of your adventure."
                    android:textColor="#64816F"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="9dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
        <LinearLayout
            android:id="@+id/itineraryListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- EXPENSES SECTION -->
    <LinearLayout
        android:id="@+id/expensesSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">


    <!-- Spending Overview -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#3159A5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL TRIP EXPENSES"
                    android:textColor="#DCE7FF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

                <TextView
                    android:id="@+id/totalSpentText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total Trip Cost: ₹0"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <View
                    android:layout_width="48dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="16dp"
                    android:background="#AFC8FF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Keep track of every shared expense"
                    android:textColor="#DCE7FF"
                    android:textSize="12sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>



        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Trip Members"
                        android:textColor="#172033"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/addMemberButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add"
                        android:textAllCaps="false"
                        app:icon="@android:drawable/ic_input_add"
                        app:iconGravity="textStart" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/memberListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="12dp">

                    <TextView
                        android:id="@+id/memberEmptyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="16dp"
                        android:text="No members added yet."
                        android:textColor="#526078"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- Add Expense -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add an expense"
            android:textColor="#172554"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E8ECF3"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <EditText
                    android:textColor="#172554"
                    android:textColorHint="#8490A5"
                    android:backgroundTint="#3159A5"
                    android:textSize="15sp"
                    android:id="@+id/payerInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Who paid?"
                    android:singleLine="true"
                    android:inputType="textCapWords"
                    android:padding="14dp" />

                <EditText
                    android:textColor="#172554"
                    android:textColorHint="#8490A5"
                    android:backgroundTint="#3159A5"
                    android:textSize="15sp"
                    android:id="@+id/amountInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Amount (₹)"
                    android:singleLine="true"
                    android:inputType="numberDecimal"
                    android:layout_marginTop="10dp"
                    android:padding="14dp" />

                <EditText
                    android:textColor="#172554"
                    android:textColorHint="#8490A5"
                    android:backgroundTint="#3159A5"
                    android:textSize="15sp"
                    android:id="@+id/descInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="What was it for?"
                    android:singleLine="true"
                    android:inputType="textCapSentences"
                    android:layout_marginTop="10dp"
                    android:padding="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addExpenseButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add Expense"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:layout_marginTop="16dp"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Expense History -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Expense history"
            android:textColor="#172554"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E8ECF3"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:id="@+id/expenseListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/expenseEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No expenses recorded yet."
                    android:textColor="#526078"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="18dp"
                    android:visibility="visible"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

        <!-- Delete Trip -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteTripButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete Trip"
            android:textAllCaps="false"
            android:textColor="#C62828"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="180dp"
            app:backgroundTint="#FCEAEA"
            app:cornerRadius="12dp" />

    </LinearLayout>

</ScrollView>
