<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E9DFD2"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Place title and planned badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/plannedPlaceNameText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Planned Stop"
                android:textColor="#332B50"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="2" />

            <TextView
                android:id="@+id/plannedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#EAF0FC"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="📌 PLANNED"
                android:textColor="#3159A5"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Location -->
        <TextView
            android:id="@+id/plannedPlaceLocationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📍 Location"
            android:textColor="#817995"
            android:textSize="13sp" />

        <!-- Planned Date -->
        <TextView
            android:id="@+id/plannedPlaceDateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="🗓 Planned for 15 December 2026"
            android:textColor="#817995"
            android:textSize="12sp" />

        <!-- Personal Note -->
        <TextView
            android:id="@+id/plannedPlaceNoteText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Personal note about planned visit."
            android:textColor="#514A62"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <!-- Edit and Delete actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/editPlannedPlaceButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Edit"
                android:textAllCaps="false"
                android:textColor="#7965C8"
                app:backgroundTint="#EEE9FF"
                app:cornerRadius="10dp"
                app:elevation="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deletePlannedPlaceButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:text="Delete"
                android:textAllCaps="false"
                android:textColor="#B45A5A"
                app:backgroundTint="#FCEAEA"
                app:cornerRadius="10dp"
                app:elevation="0dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
